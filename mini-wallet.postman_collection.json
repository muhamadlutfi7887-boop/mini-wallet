{
  "info": {
    "name": "Mini Wallet API",
    "description": "Take Home Test Mini Wallet (Node.js + Express + MySQL).\n\nCara pakai:\n1. Jalankan backend (npm run dev) dan import environment 'Mini Wallet - Local'.\n2. Jalankan folder berurutan (Runner), atau satu per satu dari atas ke bawah.\n3. Token disimpan sebagai httpOnly cookie oleh Postman; variabel {{token}} hanya cadangan (Bearer).\n4. Setiap request punya test otomatis untuk status dan pesan error.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Tanpa login (jalankan SEBELUM login)",
      "item": [
        {
          "name": "GET wallet tanpa login -> 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/wallet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallet"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Hanya valid jika cookie 'token' belum ada (cookie jar kosong). Logout di akhir folder 3 membersihkannya."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },

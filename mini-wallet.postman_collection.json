  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Data unik per run supaya collection bisa dijalankan berulang kali",
          "if (!pm.collectionVariables.get('runId')) {",
          "  const digits = () => String(Math.floor(10000000 + Math.random() * 89999999));",
          "  pm.collectionVariables.set('runId', Date.now().toString(36));",
          "  pm.collectionVariables.set('phoneA', '0811' + digits());",
          "  pm.collectionVariables.set('phoneB', '0812' + digits());",
          "}"
        ]
      }
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    }
  ]
